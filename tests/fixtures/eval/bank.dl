% === implementations ===================================================
% Tier B states it at METHOD granularity, which is what rust-analyzer would
% emit if it emitted anything.
scip_impl("scip demo store/Store#get().", "scip demo store/Backend#get().").

% Tier A states it at TYPE granularity, from the `impl T for S` syntax. The
% two are different granularities, so both rows stand.
name_impl("src/core/store.rs", "Store", "Backend", 14).
% resolved repo-wide: `Backend` has no definition in cache.rs
name_impl("src/core/cache.rs", "Cache", "Backend", 6).
% REFUSED by `trait_sym`: `Error` is an enum, not a trait. Without that guard
% `impl core::error::Error for Entry` would resolve onto this repository's own
% `Error` enum.
name_impl("src/legacy.rs", "Entry", "Error", 6).
% REFUSED by `S != T`: `impl std::error::Error for Error` writes the same bare
% identifier on both sides, and same-file resolution collapses them onto one
% symbol. That is a name-tier miss, not a fact.
name_impl("src/kinds.rs", "Error", "Error", 15).

% === resolved occurrences (tier B) =====================================
% Definition sites do NOT appear here: a SCIP occurrence carrying the
% Definition bit is routed to `def`/`at`, and there is no `def` role (#44).

% module-scope `use` lines. `From` is the document's module symbol, or the file
% where no module symbol encloses the line. Neither can call, which is what
% `calls_at`'s `def(From, ...)` and `FromKind != "module"` guards say.
scip_ref("scip demo store/open().", "src/lib.rs", 3, 5, "scip demo lib/", "import").
scip_ref("scip cargo serde 1.0.0 serde/Serialize#", "src/core/store.rs", 3, 10, "scip demo store/", "import").
scip_ref("scip cargo serde 1.0.0 serde/Deserialize#", "src/core/store.rs", 3, 22, "scip demo store/", "import").
scip_ref("scip cargo libpq 0.9.0 libpq/Connection#", "src/db/conn.rs", 4, 5, "src/db/conn.rs", "import").
scip_ref("scip npm @types/react 18.2.0 react/useState().", "web/app.ts", 5, 10, "scip ts app/", "import").

