% codeintel standard library.
%
% Every rule here is derived from the base relations in specs/01-facts.md.
% A new structural question is a rule in this file — not a function, not a CLI
% verb, not an MCP tool. That is the mechanism that keeps this project small.
%
% Two conventions run through the whole file:
%   * Seeded traversals take the seed FIRST (impact_of, reach_of). The engine
%     pushes that binding into the recursion, so evaluation grows outward from
%     the seed instead of computing all-pairs reachability.
%   * Anything reading `calls` or `ref` is contaminated by resolution quality.
%     Nine such rules ship in both forms: the `name`-tolerant one and the
%     `_exact` one that gates on SCIP evidence. `about` is the one deliberate
%     exclusion — it orients, it does not adjudicate, and when provenance
%     matters you ask `calls_exact` instead. The roster is exhaustive and is
%     written down in specs/01-facts.md § Tier precedence; do not grow it here
%     without growing it there.

% === visibility ========================================================
% `exported` is DERIVED. The extractor records what a definition SAYS about
% itself (`visibility`); whether that makes it visible outside the crate is a
% question about its ancestors, which is a join and not a token.

%% exported(S)  S is visible outside its crate: public, inherited from parent, or in name_export.
exported(S) :- visibility(S, "public").

% An enum variant, a trait item and a trait-impl method have nowhere to write
% `pub`, so they are as visible as whatever owns them. Recursive, so a variant
% of a public enum inside a public module needs no special case and depth is
% not capped. A trait-impl method reaches its answer through `parent`, which is
% the TYPE: a `pub` trait implemented for a private type gives methods nobody
% outside can name, and calling those exported would make `dead_export` demand
% documentation for unreachable code.
exported(S) :- visibility(S, "inherited"), parent(S, P), exported(P).

% A TypeScript `export { x }` or `export default x` is a clause the declaration
% never sees, so `visibility` says `restricted` and this row says exported. Same
% file, local name; the alias in `f as g` is not recorded (01-facts.md
% § `name_export`).
exported(S) :- name_export(F, N), def(S, F, _, N).

% `restricted` appears in no rule, and that is the point: `pub(crate)` and a
% bare `fn` are both "not visible outside the crate", which is exactly the
% question `exported` asks.

% === implements ========================================================
% Also DERIVED, for the reason `ref` is: tier B states it exactly when the
% indexer bothers to — rust-analyzer never does — and tier A can state it by
% name from one file's syntax.

%% implements(S, T, Prov)  S implements or overrides T.
implements(S, T, "exact") :- scip_impl(S, T).

% Tier A resolves both written names with the policy `ref` uses, reusing
% `local_def` and `ambiguous` below. The guard is per-PAIR: `scip_impl` is
% method-level where an indexer emits it at all and `name_impl` is type-level,
% so they are different granularities and both rows are true.
%
% Two guards, both because `TypeName` and `TraitName` are final identifiers
% only — no path, by design (01-facts.md § `name_impl`) — so the leading
% segments are gone by the time a rule sees them (#40).
%
% `trait_sym(T)`: the name before `for` is a trait declaration, so a `def`
% that is not one is a different thing wearing the same final identifier.
% `impl core::error::Error for Diagnostic` must not resolve to the `Error`
% ENUM this repository exports.
%
% `S != T`: no type implements itself. `impl std::error::Error for Error`
% writes the same bare name on both sides of `for` and the same-file clause
% of `impl_sym` resolves both to the one local `Error` type. A resolution
% that collapses two different written names onto one symbol is a name-tier
% MISS, not a fact.
%
% Both tighten a tier that may be wrong by construction, so a row they drop
% was never evidence.
implements(S, T, "name") :-
    name_impl(F, TypeN, TraitN, _),
    impl_sym(F, TypeN, S), impl_sym(F, TraitN, T),
    trait_sym(T), S != T, !scip_impl(S, T).

%% trait_sym(S)  a definition the trait side of an `impl` can name.
% A relation rather than three copies of the rule above. `class` is here for
% Python, whose protocols and ABCs are classes; omitting it would silently
% refuse every Python row the day a `@trait` capture lands for it. Only Rust
% emits `name_impl` today (`queries/rust/tags.scm`), so the other two are
% forward cover.
trait_sym(S) :- def(S, _, "trait", _).
trait_sym(S) :- def(S, _, "interface", _).
trait_sym(S) :- def(S, _, "class", _).

%% impl_sym(F, Name, S)  a name an `impl` writes, as a symbol.
% Four clauses: either side of the `for`, each resolved same-file-first. The
% leading `name_impl` binds F and N POSITIVELY, which is what makes the negated
% branches safe — a rule whose only binder for a variable is `!local_def(F, N)`
% is rejected by the engine, and that is why `ref` leads with `name_ref` too.
impl_sym(F, N, S) :- name_impl(F, N, _, _), def(S, F, _, N).
impl_sym(F, N, S) :- name_impl(F, _, N, _), def(S, F, _, N).
% else a unique exported definition repo-wide
impl_sym(F, N, S) :- name_impl(F, N, _, _),
    !local_def(F, N), def(S, _, _, N), exported(S), !ambiguous(N).
impl_sym(F, N, S) :- name_impl(F, _, N, _),
    !local_def(F, N), def(S, _, _, N), exported(S), !ambiguous(N).

% === reference resolution ==============================================
% `ref` is DERIVED. Tier B contributes resolved occurrences directly; tier A
% contributes names that these rules resolve against the whole-repo def set.
% To tighten resolution, edit the two `name` rules. To disable tier-A
% resolution entirely, delete them: `ref` degrades to `exact` only.

% A `scip_ref` row is an occurrence the indexer EMITTED, not necessarily one it
% RESOLVED. scip-typescript writes an opaque per-document placeholder — `local
% <file> <N>`, no name, no definition in any document — wherever it cannot bind
% a name, which is its way of saying "something is here and I could not name
% it". So the question both tiers ask is not "is there a row here" but "does
% the row name a symbol anything knows about".
%
%% scip_claim(F, Line, Col)  tier B resolved the occurrence at this position.
% Two clauses because an index knows a symbol two ways, and BOTH are claims: it
% has a `def` here, or it names a third-party package and carries an `extern`
% row. `def` alone un-suppresses tier A at every reference into a dependency,
% which is the worst place for it: `Map#get()` has no `def`, and freeing that
% position restores the `Store::get` self-edge the guard exists to kill (#56).
%
% Spelled out rather than factored through a `known_sym(S)` relation, which is
% what this said first. A derived predicate shared between this rule and `ref`
% keeps `scip_claim` wired into the demand graph even after the rewrite backs
% it off, so `?- def(S, _, _, N), impact_of(S, C).` fell all the way back to
% the plain program and computed all-pairs reachability. Over base relations
% only, backing off leaves rules the rewrite can ignore — which is why
% `local_def` and `ambiguous` are shaped this way too.
scip_claim(F, Line, Col) :- scip_ref(S, F, Line, Col, _, _), def(S, _, _, _).
scip_claim(F, Line, Col) :- scip_ref(S, F, Line, Col, _, _), extern(S, _, _, _).

%% ref(S, F, Line, Col, From, Role, Prov)  resolved occurrence. Prov says which tier.
% The same two clauses here, so the partition is a partition: an occurrence
% whose target nothing can describe yields no row at either tier, instead of an
% `exact` row naming a symbol that answers no question. Everything downstream
% already joins through `def` or `extern`, so the dropped rows were inert, and
% `scip_ref` keeps the unfiltered record of what the indexer emitted.
ref(S, F, L, C, From, Role, "exact") :-
    scip_ref(S, F, L, C, From, Role), def(S, _, _, _).
ref(S, F, L, C, From, Role, "exact") :-
    scip_ref(S, F, L, C, From, Role), extern(S, _, _, _).

% Name matching is a FALLBACK, not a parallel claim: `!scip_claim` restricts it
% to occurrences tier B never resolved, so the tiers partition the positions
% instead of both claiming them (`specs/01-facts.md` § Tier precedence).
% Vacuous without a SCIP index, so tier-A-only output is unchanged.
% same file wins
ref(S, F, L, C, From, "read", "name") :-
    name_ref(N, F, L, C, From), !scip_claim(F, L, C), def(S, F, _, N).

% else a unique exported definition repo-wide
ref(S, F, L, C, From, "read", "name") :-
    name_ref(N, F, L, C, From), !scip_claim(F, L, C), !local_def(F, N),
    def(S, _, _, N), exported(S), !ambiguous(N).

%% local_def(F, Name)  the NAME has a definition in file F. Not a symbol.
local_def(F, N) :- def(S, F, _, N).

% Grouped, not a self-join: the self-join form emits k*k candidate pairs for a
% name with k definitions before dedup, and the aggregate form is free.
% Grouped over NAMES, not def rows: `def(_, _, _, N)` as the outer literal
% binds N once per definition, so the count ran once per row and a name with
% k definitions was counted k times. `named` is a set, so it runs once.
%% named(Name)  some definition carries this name.
named(N) :- def(_, _, _, N).
%% ambiguous(Name)  names >1 definition, so name matching cannot pick.
ambiguous(N) :- named(N), C = count{ S : def(S, _, _, N) }, C > 1.

% === the location bridge ===============================================
% Turns a file:line from ripgrep, git diff, a stack trace or a compiler error
% into a symbol. This is how anything gets INTO the graph.
%
% `between` GENERATES when its first two arguments are bound, so Line appears
% in a positive body literal and the rule is unconditionally safe. Written with
% bare comparisons instead, Line would be bound by nothing and the engine would
% reject its own standard library.

%% symbol_at(F, Line, S)  every def whose span covers Line. Prefer innermost_at.
symbol_at(F, Line, S) :- def(S, F, _, _), def_span(S, L1, L2, _, _),
                         between(L1, L2, Line).

%% innermost_at(F, Line, S)  location -> tightest enclosing symbol.
innermost_at(F, Line, S) :- symbol_at(F, Line, S), !tighter_at(F, Line, S).

% T is strictly tighter than S: compare widths, not endpoints, so two
% definitions sharing an identical span do not cancel each other out and leave
% `innermost_at` empty.
%% tighter_at(F, Line, S)  helper for innermost_at.
tighter_at(F, Line, S) :- symbol_at(F, Line, S), symbol_at(F, Line, T), T != S,
                          def_span(S, A, B, _, _), def_span(T, C, D, _, _),
                          V = B - A, W = D - C, W < V.

% === callability =======================================================
%% callable(Kind)  function | method | constructor | macro.
callable("function").
callable("method").
callable("constructor").
callable("macro").

% === calls: a reference to a callable, attributed to its enclosing def ==
%% calls_at(From, S, F, Line, Prov)  one call site, with its line and provenance.
% There is no `Role != "def"` test here any more. `scip_ref` never carries a
% `def` row — a definition occurrence is routed to `def`/`at` — so the test
% filtered nothing, and `def` is no longer in the `Role` vocabulary at all
% (#44). An import/re-export occurrence — role `import` or role-less — passes
% straight through with `From` bound to the enclosing file, not a def.
% `def(From, _, _, _)` is the guard that actually does the work: a call site must be enclosed by a
% definition, so `use x::f` / `pub use m::f` (attributed to the file) drop
% out, and `impact_of`/`entrypoint` stop treating a file as a caller.
%
% `FromKind != "module"` is the same guard finished. A module-scope reference
% has two spellings of one owner: the file, when nothing encloses it, and the
% document's own module symbol, when the indexer gave that symbol an enclosing
% range the reference falls inside. Both are the file. Only the first was
% refused, so whether `export default outer` became a `calls` row turned on
% whether that range happened to be placeable in the source on disk — a file
% one line longer than the index flipped it (#75). The module is a `def`, so
% the `def(From, ...)` guard passes; it is not a body, so it cannot call.
calls_at(From, S, F, L, Prov) :-
    ref(S, F, L, _, From, _, Prov),
    def(From, _, FromKind, _), FromKind != "module",
    def(S, _, K, _), callable(K).

%% calls(From, S)  From calls S.
calls(From, S) :- calls_at(From, S, _, _, _).
%% calls_exact(From, S)  From calls S, SCIP-resolved only.
calls_exact(From, S) :- calls_at(From, S, _, _, "exact").

% `callers`/`callees` were here until schema 2. Both were `calls/2` verbatim
% with the variables renamed, so they bought an agent nothing it could not ask
% of `calls` directly, and the schema budget is the one that binds. Ask
% `?- calls(C, S)` and bind whichever argument you know.

% `callers_by_name`/`impact_by_name` were here until schema 3. Both were one
% join over `calls`/`impact_of` spelled as a rule, and the schema budget is the
% one that binds: ask `?- calls(C, S), def(S, _, _, "open")` and bind the name.

% === transitive closure, SEEDED ========================================
% Always prefer these.

%% impact_of(Seed, Caller)  transitive callers. SEED THE 1st ARG.
impact_of(Seed, C) :- calls(C, Seed).                     % who calls Seed
impact_of(Seed, C) :- impact_of(Seed, B), calls(C, B).    % ...transitively

%% reach_of(Seed, Callee)  transitive callees. SEED THE 1st ARG.
reach_of(Seed, C) :- calls(Seed, C).                      % what Seed calls
reach_of(Seed, C) :- reach_of(Seed, B), calls(B, C).

%% impact_of_exact(Seed, Caller)  impact_of, SCIP-resolved only. SEED THE 1st ARG.
impact_of_exact(Seed, C) :- calls_exact(C, Seed).
impact_of_exact(Seed, C) :- impact_of_exact(Seed, B), calls_exact(C, B).

%% reach_of_exact(Seed, Callee)  reach_of, SCIP-resolved only. SEED THE 1st ARG.
reach_of_exact(Seed, C) :- calls_exact(Seed, C).
reach_of_exact(Seed, C) :- reach_of_exact(Seed, B), calls_exact(B, C).

% === transitive closure, UNSEEDED ======================================
% Whole-graph questions only. On a large repo these are O(n^2) and will hit
% max_derived_tuples; that is the honest cost of asking about every pair.

%% reaches(A, B)  UNSEEDED all-pairs. Expensive.
reaches(A, B) :- calls(A, B).
reaches(A, C) :- reaches(A, B), calls(B, C).
%% recursive(S)  S is on a call cycle. UNSEEDED.
recursive(S) :- reaches(S, S).

% Name matching joins `A.run()` against every `B.run` in the repo, so a
% transitive closure over `calls` closes cycles between unrelated classes and
% `recursive` answers with whatever name is commonest — `__init__`, `run`,
% `parse_args` (#53). The closure is where the damage compounds: one invented
% edge is one wrong row in `calls`, but any invented edge anywhere on a path
% invents the whole path. These are the forms that can be believed.
%% reaches_exact(A, B)  reaches, SCIP-resolved only. UNSEEDED. Expensive.
reaches_exact(A, B) :- calls_exact(A, B).
reaches_exact(A, C) :- reaches_exact(A, B), calls_exact(B, C).
%% recursive_exact(S)  recursive, SCIP-resolved only. UNSEEDED.
recursive_exact(S) :- reaches_exact(S, S).

% === location helpers ==================================================
%% file_of(S, F)  the file S is defined in.
file_of(S, F) :- def(S, F, _, _).
% `defines(F, S)` was here until schema 2: `file_of` with the arguments the
% other way, and Datalog does not need a second spelling to bind either one.
%% at(S, F, Line)  where S starts: file and first line.
at(S, F, L) :- def(S, F, _, _), def_span(S, L, _, _, _).

% === containment closure ===============================================
% within(Child, Ancestor). The argument order is parent's, and an agent reading
% only a signature has to be told which is which — one M1 eval sample reversed
% it (docs/agent-eval.md).
%% within(Child, Ancestor)  transitive containment. Child is FIRST.
within(C, P) :- parent(C, P).
within(C, A) :- parent(C, P), within(P, A).

% === tests =============================================================
% `file(F, _)` is not decoration: without it F is a head variable bound only by
% a filter, which violates range restriction exactly as symbol_at would.
%% is_test(F)  test file, by path.
is_test(F) :- file(F, _), match(F, "(^|/)(tests?|__tests__)/").
is_test(F) :- file(F, _), match(F, "_test\\.(go|py|rs)$").
is_test(F) :- file(F, _), match(F, "(^|/)(test_[^/]*|tests|conftest)\\.py$").
is_test(F) :- file(F, _), match(F, "\\.(test|spec)\\.(ts|tsx|js|jsx)$").
% The last clause is inert today: no indexer measured emits SymbolRole::Test
% (0 rows of "test" in all four fixtures' SCIP), and scip.rs ranks read/write
% above test, so a test+read occurrence reports `read`. It stays because it is
% correct the day an indexer sets the bit; until then `scip_ref` hands this
% rule nothing and `is_test` is path-only. specs/01-facts.md § Role.
is_test(F) :- scip_ref(_, F, _, _, _, "test").

% === orientation: everything about one symbol, in one round trip =======
% Heterogeneous rows sharing a discriminator column. One query instead of six,
% and the definition of "orientation" stays editable.

%% about(S, Rel, A, B, Line)  all of S in one trip. A,B,Line = file, name, line of the RELATED symbol (sig/doc: A = text). Rel = sig|doc|defined|parent|caller|
%%   callee|implements|implementor|test|extern
about(S, "sig",         Sig, "", 0) :- def_sig(S, Sig).
about(S, "doc",         Doc, "", 0) :- def_doc(S, Doc).
about(S, "defined",     F,   N,  L) :- def(S, F, _, N), at(S, F, L).
about(S, "parent",      F,   N,  L) :- parent(S, P), def(P, F, _, N), at(P, F, L).
about(S, "caller",      F,   N,  L) :- calls(C, S), def(C, F, _, N), at(C, F, L).
about(S, "callee",      F,   N,  L) :- calls(S, C), def(C, F, _, N), at(C, F, L).
about(S, "implements",  F,   N,  L) :- implements(S, T, _), def(T, F, _, N), at(T, F, L).
about(S, "implementor", F,   N,  L) :- implements(T, S, _), def(T, F, _, N), at(T, F, L).
about(S, "test",        F,   N,  L) :- calls(C, S), def(C, F, _, N), is_test(F), at(C, F, L).
about(S, "extern",      P,   V,  0) :- extern(S, _, P, V).

% === file-level dependency =============================================
%% depends(F, G)  F references something defined in G.
depends(F, G) :- ref(S, F, _, _, _, _, _), def(S, G, _, _), F != G.

% === the dex "34 methods", as rules ====================================
% `dead_export` over a `name`-provenance graph OVER-REPORTS: an unresolved call
% is an invisible call. `entrypoint` does not degrade, it INVERTS — which is why
% every contaminated rule below ships in an `_exact` form too.

% `def(S, F, _, _)` is what binds F. Written as 01-facts.md had it —
% `ref_outside(S, F) :- ref(S, G, ...), G != F.` — F appears in the head and
% only in a comparison, so the rule is not range-restricted and the engine
% rejects its own standard library. F is always S's defining file at every call
% site, so naming that is both the fix and the honest reading.
%% dead_export(S)  exported, unreferenced elsewhere. See tier.
dead_export(S) :- exported(S), def(S, F, _, _), !ref_outside(S, F).
%% ref_outside(S, F)  helper for dead_export.
ref_outside(S, F) :- def(S, F, _, _), ref(S, G, _, _, _, _, _), G != F.

%% entrypoint(S)  a callable nothing calls. See tier; NOT dead code, see entrypoint_exact.
entrypoint(S) :- def(S, _, K, _), callable(K), !calls(_, S).

%% def_lines(S, Lines)  lines S spans, first and last counted. Pick a threshold.
% B - A is the gap between the first and last line, one less than the count.
% A definition on lines 29..38 spans 10 lines and this reported 9, so the
% documented `N > 50` silently excluded every 51-line definition and
% `long_def`'s "more than 80 lines" meant more than 81.
def_lines(S, N) :- def_span(S, A, B, _, _), H = B - A, N = H + 1.

% `long_def(S)` -- `def_lines(S, Lines), Lines > 80` -- was here until schema 3.
% Its own doc line said to use `def_lines` instead, and a threshold nobody can
% change is copy in the one output with a size budget.

% A `mod x;` declaration and the file `x.rs` are two `def` rows. Visibility lands
% on the declaration, the `//!` doc and every reference on the file, and tier A
% cannot join them: that is a path computation. SCIP can -- the declaration's
% name token is an occurrence of the file's symbol -- so this is exact-only. A
% declaration SCIP did not anchor has no link and is not guessed at (#115).
%% mod_file(D, M)  D is a `mod x;` declaration, M the file module it names. SCIP only.
mod_file(D, M) :- def(D, F, "module", _), def_name(D, L, C), scip_ref(M, F, L, C, _, _), M != D.

%% undocumented_export(S)  exported with no doc comment, on it or on the file a `mod x;` names (SCIP).
undocumented_export(S) :- exported(S), !def_doc(S, _), !documented_file(S).
documented_file(D) :- mod_file(D, M), def_doc(M, _).

% P is `extern`'s Pkg: the package the INDEXER attributed the symbol to, not
% the specifier the source wrote. An npm package typed through DefinitelyTyped
% resolves into `@types/<pkg>`, so `?- uses_package(F, "react").` is zero rows
% on a repository where every file imports `react` (#58). The two names are not
% convertible and this does not union `import` in: `Module` is a per-language
% specifier, not a package name -- `"std::collections::HashMap"` in Rust,
% `"\"fmt\""` in Go, `"../db/conn"` in TypeScript. Rewriting either side into
% the other is the guess 02-extraction.md forbids. Ask `import` instead.
%% uses_package(F, P)  F uses package P as the INDEXER names it -- `@types/x`,
%%   not `x`. Imports: ask `import`. #58
uses_package(F, P) :- ref(S, F, _, _, _, _, _), extern(S, _, P, _).

% === the precise forms =================================================
% What a row asks of its reader (#114). The edit a row invites is narrowing the
% export, and an `inherited` S (variant, trait item, trait-impl method) has no
% slot to narrow: on this repository 35 of 98 rows. `!visibility(S, "inherited")`
% removes exactly those; `visibility(S, "public")` also drops a TypeScript
% `export { x }`, which is `restricted` and narrowable. A filter the caller
% writes, not a rule: see specs/01-facts.md.
%% dead_export_exact(S)  dead_export, SCIP refs only. Variants, trait-impl members cannot be narrowed: !visibility(S, "inherited").
dead_export_exact(S) :- exported(S), resolved(S), def(S, F, _, _),
                        !ref_outside_exact(S, F).
%% ref_outside_exact(S, F)  ref_outside, SCIP-resolved refs only.
ref_outside_exact(S, F) :- def(S, F, _, _), ref(S, G, _, _, _, _, "exact"), G != F.

% What this can and cannot see (#111). A row is "no SCIP reference to S sits
% inside a definition", and that is all it is. It does NOT consult
% `scip_impl`/`implements` -- a perfect indexer would not change that -- so:
%   * a call through a trait or interface names the TRAIT's method, and every
%     implementing method lists here though it is live (verified on Go, where
%     `scip_impl` has rows and the impl still lists);
%   * `#[cfg(test)]` functions inside a source file list, because `is_test` is
%     path-only;
%   * a definition the anchor join did not reach (`resolved` absent) never
%     lists, live or dead: absence here is not evidence of use either;
%   * a reference outside any definition (file-scope code) is no call (see
%     `calls_at`), so what only file-scope code calls lists.
% `?- entrypoint_exact(S), parent(S, P), def(P, _, "module", _).` -- free
% functions only -- drops the first class: a module-level function is not a
% trait's. It is a filter the caller writes, not a rule: dropping every
% member from the answer is a judgment about dead inherent methods.
%% entrypoint_exact(S)  entrypoint, SCIP calls only. A candidate, not dead code: trait/interface impls and in-file tests list; unanchored defs never do.
entrypoint_exact(S) :- def(S, _, K, _), callable(K), resolved(S),
                       !calls_exact(_, S).
%% depends_exact(F, G)  depends, SCIP-resolved refs only.
depends_exact(F, G) :- ref(S, F, _, _, _, _, "exact"), def(S, G, _, _), F != G.
%% uses_package_exact(F, P)  uses_package, SCIP-resolved only; P is the indexer's name. #58
uses_package_exact(F, P) :- ref(S, F, _, _, _, _, "exact"), extern(S, _, P, _).

% === row provenance ====================================================
% The five rules above that read `calls` or `ref` drop `Prov` from their
% tuples. `tier` hands it back without changing any of their heads: the same
% rows, one more column, two values (specs/01-facts.md § Row provenance).
% `exact` iff the `_exact` twin also yields the row; the pair of clauses is a
% partition. `dead_export`/`entrypoint` join their name form because their twin
% is not a subset of it (it also demands `resolved(S)`).
%% tier(Rel, A, B, Prov)  Prov of calls|depends|uses_package|dead_export|entrypoint rows. Unary: B=""
tier("calls", A, B, "exact")        :- calls_exact(A, B).
tier("calls", A, B, "name")         :- calls(A, B), !calls_exact(A, B).
tier("depends", A, B, "exact")      :- depends_exact(A, B).
tier("depends", A, B, "name")       :- depends(A, B), !depends_exact(A, B).
tier("uses_package", A, B, "exact") :- uses_package_exact(A, B).
tier("uses_package", A, B, "name")  :- uses_package(A, B), !uses_package_exact(A, B).
tier("dead_export", S, "", "exact") :- dead_export(S), dead_export_exact(S).
tier("dead_export", S, "", "name")  :- dead_export(S), !dead_export_exact(S).
tier("entrypoint", S, "", "exact")  :- entrypoint(S), entrypoint_exact(S).
tier("entrypoint", S, "", "name")   :- entrypoint(S), !entrypoint_exact(S).
